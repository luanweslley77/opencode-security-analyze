{
  "name": "@opencode-ai/plugin-security",
  "version": "0.1.3",
  "description": "Security analysis plugin for OpenCode — SAST scanning, dependency vulnerability detection, PoC execution, and security patching. Ported from Gemini CLI Security Extension.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "plugin/src",
    "osv-scanner",
    "skills",
    "commands",
    "scripts",
    "tsconfig.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "test": "echo 'No tests configured — see test-results/ for E2E test reports'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luanweslley77/opencode-security-analyze.git"
  },
  "bugs": {
    "url": "https://github.com/luanweslley77/opencode-security-analyze/issues"
  },
  "homepage": "https://github.com/luanweslley77/opencode-security-analyze#readme",
  "author": "Luan Weslley <luanweslley77@gmail.com>",
  "keywords": [
    "opencode",
    "plugin",
    "security",
    "sast",
    "vulnerability",
    "osv-scanner",
    "code-audit",
    "dependency-scan",
    "poc"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "bun@latest",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.4.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
